# ---------------------------------------------------------------
# CampusPass backend configuration
# Copy to `.env` and adjust. SQLite paths are relative to prisma/.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local development database (zero-config SQLite)
DATABASE_URL="file:./dev.db"

# Auth - CHANGE THESE IN PRODUCTION (min 32 chars recommended)
JWT_SECRET="change-me-to-a-long-random-jwt-secret-value"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10

# HMAC-SHA256 key used to sign ticket QR payloads
QR_HMAC_SECRET="change-me-to-a-long-random-qr-hmac-secret"

# Comma separated list of allowed origins, or * for any
CORS_ORIGIN="*"
# Frontend dev server: http://localhost:5173

# Requests per 15 minutes per IP on /api/auth/*
AUTH_RATE_LIMIT_MAX=100
